<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="433.0" prefWidth="847.0" xmlns="http://javafx.com/javafx/11.0.14-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.nrc.atlasjavafx.Controladores.ProveedorController">
    <children>
        <Label layoutX="14.0" layoutY="14.0" text="Gestión de Proveedores">
            <font>
                <Font size="24.0" />
            </font>
        </Label>
        <TableView fx:id="tablaProveedores" layoutX="14.0" layoutY="73.0" prefHeight="200.0" prefWidth="819.0">
            <columns>
                <TableColumn fx:id="colId" prefWidth="75.0" text="ID" />
                <TableColumn fx:id="colNombre" prefWidth="182.0" text="Nombre" />
                <TableColumn fx:id="colArea" prefWidth="123.0" text="Área" />
                <TableColumn fx:id="colContacto" prefWidth="98.0" text="Contacto" />
                <TableColumn fx:id="colDireccion" prefWidth="147.0" text="Dirección" />
                <TableColumn fx:id="colAntiguedad" prefWidth="193.0" text="Antiguedad" />
            </columns>
        </TableView>
        <Label layoutX="29.0" layoutY="302.0" text="Nombre:" />
        <Label layoutX="29.0" layoutY="340.0" text="Área:" />
        <Label layoutX="29.0" layoutY="371.0" text="Contacto:" />
        <Label layoutX="328.0" layoutY="302.0" text="Dirección:" />
        <Label layoutX="328.0" layoutY="340.0" text="Antiguedad:" />
        <TextField fx:id="txtNombre" layoutX="97.0" layoutY="298.0" />
        <TextField fx:id="txtArea" layoutX="97.0" layoutY="336.0" />
        <TextField fx:id="txtContacto" layoutX="97.0" layoutY="367.0" />
        <TextField fx:id="txtDireccion" layoutX="393.0" layoutY="298.0" />
        <TextField fx:id="txtAntiguedad" layoutX="393.0" layoutY="336.0" />
        <Button fx:id="btnAgregar" layoutX="638.0" layoutY="288.0" mnemonicParsing="false" onAction="#agregarProveedor" styleClass="agregar" stylesheets="@mainFormDesign.css" text="Agregar" />
        <Button fx:id="btnModificar" layoutX="634.0" layoutY="326.0" mnemonicParsing="false" onAction="#modificarProveedor" styleClass="modificar" stylesheets="@mainFormDesign.css" text="Modificar" />
        <Button fx:id="btnEliminar" layoutX="638.0" layoutY="366.0" mnemonicParsing="false" onAction="#eliminarProveedor" styleClass="eliminar" stylesheets="@mainFormDesign.css" text="Eliminar" />
        <Button fx:id="btnRespaldar" layoutX="594.0" layoutY="405.0" mnemonicParsing="false" onAction="#respaldarProductos" prefHeight="25.0" prefWidth="140.0" styleClass="respaldar" stylesheets="@mainFormDesign.css" text="Respaldar" />
    </children>
</AnchorPane>
